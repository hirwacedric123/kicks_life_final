# ============================================
# Django Settings
# ============================================

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one-for-production

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list)
# For development: localhost,127.0.0.1
# For production: your-domain.com,www.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ============================================
# Database Configuration
# ============================================

# PostgreSQL Database URL (for production)
# Format: postgresql://user:password@host:port/database
# This is automatically provided by Render, Fly.io, etc.
# For local development, leave this commented to use SQLite
# DATABASE_URL=postgresql://user:password@host:port/database


# ============================================
# Email Configuration (for OTP and notifications)
# ============================================

# SMTP Server (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Email credentials
# For Gmail, you need to use an App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default sender email
DEFAULT_FROM_EMAIL=KoraQuest <noreply@koraquest.com>


# ============================================
# CORS Settings
# ============================================

# Comma-separated list of allowed origins for CORS
# For development: http://localhost:3000,http://127.0.0.1:3000
# For production: https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ============================================
# Deployment Platform Configuration
# ============================================

# Render Configuration (automatically set by Render)
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# PythonAnywhere Configuration
# Your PythonAnywhere username (e.g., kickslife250)
# This automatically configures: yourusername.pythonanywhere.com
PYTHONANYWHERE_USERNAME=

# Custom Domain for PythonAnywhere Hacker Plan
# Enter your custom domain without www or protocol
# Example: kickslife250.com (not www.kickslife250.com or https://kickslife250.com)
# This automatically adds both kickslife250.com and www.kickslife250.com to ALLOWED_HOSTS
CUSTOM_DOMAIN=www.kickslife250.com

# Fly.io Configuration (automatically set by Fly.io)
# FLY_APP_NAME=your-app-name


# ============================================
# Django Superuser (Optional)
# ============================================

# These are optional and used for creating superuser via environment variables
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@koraquest.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-password


# ============================================
# Usage Instructions
# ============================================

# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env and fill in your actual values
#
# 3. Make sure .env is in .gitignore (never commit .env to git!)
#
# 4. For production deployments:
#    - Set DEBUG=False
#    - Generate a new SECRET_KEY
#    - Configure proper ALLOWED_HOSTS
#    - Set up email credentials
#    - Configure platform-specific variables (RENDER_EXTERNAL_HOSTNAME, PYTHONANYWHERE_USERNAME, etc.)
